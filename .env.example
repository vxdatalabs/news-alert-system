# Copy this file to .env and fill in your own values. Never commit .env.

# Finnhub API key (free tier works): https://finnhub.io
FINNHUB_API_KEY=your-finnhub-key

# Telegram bot (create with @BotFather; get your chat id with get_telegram_chat_id.py)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Optional: a Discord webhook as a second delivery channel
DISCORD_WEBHOOK_URL=
